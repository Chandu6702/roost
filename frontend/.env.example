# Where the Spring Boot API runs (the Vite dev proxy forwards /auth, /monitors,
# /workspaces, /incidents, /public here). Defaults to http://localhost:8080.
VITE_API_TARGET=http://localhost:8080

# Optional. The public status page resolves its tenant from the Host header,
# which a browser can't set. To preview that page locally, set this to a seeded
# workspace's subdomain and the dev proxy will forward it on /public requests.
# VITE_PUBLIC_HOST=acme.roost.local
